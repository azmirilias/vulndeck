# VulnDeck optional API keys — copy to .env (mode 600) and fill in.
# Each key turns on one feature; leave it empty to disable that source.
# vulndeck.service loads this file via EnvironmentFile.

# VirusTotal — IOC enrichment (IP / domain reputation)
VT_KEY=

# abuse.ch — ThreatFox (IOC search), MalwareBazaar (hash), URLhaus (URL)
ABUSE_CH_KEY=

# AlienVault OTX — pulses & malware association for IP / domain / URL
OTX_KEY=

# Shodan — optional; the free "oss" key reports zero query credits
SHODAN_KEY=

# GitHub — raises the PoC repository-search rate limit (anonymous = 60 req/h)
GITHUB_TOKEN=
